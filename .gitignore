# PlatformIO build output and downloaded libraries
.pio/

# editor / OS noise
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# python
__pycache__/
*.pyc

# your WiFi credentials and location - copy config.example.h to config.h
src/config.h

# built clock images embed your WiFi credentials - never commit them.
# (the displaytest images have no WiFi in them and are fine)
firmware/*/clock.bin

# regenerated by every build; would churn on every commit
firmware/*/manifest.json

# dropped into src/ by the pioarduino component manager on a first build; not needed
src/idf_component.yml
src/idf_component.yml.orig

# Release images, built by scripts/release.py and attached to a GitHub
# release rather than committed. Same reason clock.bin is ignored: an image
# built on a machine that has a config.h carries its WiFi password.
dist/
tools/flasher/build/
tools/flasher/*.spec
